{
  "name": "unspool-mental-health",
  "private": true,
  "version": "1.0.0",
  "license": "LGPL-2.1-only",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:frontend": "vite --host 0.0.0.0",
    "dev:backend": "bun scripts/backend.ts server",
    "dev:worker": "bun scripts/backend.ts worker",
    "build": "vite build",
    "start": "bun scripts/backend.ts server",
    "backend:migrate": "bun scripts/backend.ts migrate",
    "check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "bun run build && playwright test",
    "backend:test": "bun scripts/backend.ts test",
    "backend:check": "bun scripts/backend.ts check",
    "check": "bun run check:svelte && bun run test && bun run backend:check && bun run backend:test && bun run build"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@lucide/svelte": "^1.30.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "svelte": "^5.56.8",
    "vite": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/bun": "^1.3.14",
    "jsdom": "^29.1.1",
    "svelte-check": "^4.7.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
